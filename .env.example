# ------------------------------------------------------------------ modelo
# Informe a sua chave pessoal da API do Gemini, criada no Google AI Studio.
#
# O modelo é Gemini 2.5 Flash Lite e usa o endpoint oficial do Google.
BOOTCAMP_API_KEY=

# --------------------------------------------------------------------- MCP
# O servidor MCP roda na sua máquina. Suba com:
#   docker compose up mcp
# ou clone o repositório mcp-operadora e rode:
#   MCP_OPERADORA_DADOS=./casos_treino MCP_OPERADORA_TOKEN=treino \
#       python -m mcp_operadora.server
MCP_OPERADORA_URL=http://localhost:9000/mcp
MCP_OPERADORA_TOKEN=treino
